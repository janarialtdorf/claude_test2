# Copy this file to .env.local and fill in your own values.
# Find them in the Supabase dashboard: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# SECRET — server only. Needed to place (demo) orders. Never commit it, never
# share it, and never rename it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_key_here
